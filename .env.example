# Copie este arquivo para .env e preencha os valores.

# Conexão com o PostgreSQL.
# No Render, copie a "Internal Database URL" do banco criado.
DATABASE_URL=postgresql://usuario:senha@localhost:5432/revisado

# Chave usada para assinar o cookie de sessão.
# Gere uma aleatória, por exemplo com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=coloque-uma-chave-aleatoria-aqui

# Em produção, use: production
NODE_ENV=development
